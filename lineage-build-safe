#!/usr/bin/env python3
"""Adjust LineageOS build parallelism to macOS swap usage."""

import argparse
import math
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time

GIB = 1024 ** 3


def swap_used():
    output = subprocess.check_output(
        ["/usr/sbin/sysctl", "-n", "vm.swapusage"], text=True
    )
    match = re.search(r"used\s*=\s*([\d.]+)([KMGT])", output)
    if not match:
        raise RuntimeError("Cannot read swap usage: " + output.strip())
    return float(match[1]) * 1024 ** ("KMGT".index(match[2]) + 1)


def free_memory():
    # Conservative headroom estimate: exclude inactive pages, which may
    # contain dirty anonymous memory as well as reclaimable file cache.
    output = subprocess.check_output(["/usr/bin/vm_stat"], text=True)
    page_size = re.search(r"page size of (\d+) bytes", output)
    if not page_size:
        raise RuntimeError("Cannot read VM page size")
    pages = 0
    for name in ("free", "speculative", "purgeable"):
        match = re.search(r"Pages " + name + r":\s*(\d+)", output)
        if not match:
            raise RuntimeError("Cannot read VM pages: " + name)
        pages += int(match[1])
    return pages * int(page_size[1])


def log_mtime(path):
    try:
        return path.stat().st_mtime_ns
    except FileNotFoundError:
        return None


def kernel_running(process):
    output = subprocess.check_output(
        ["/bin/ps", "-axo", "pgid=,args="], text=True
    )
    for line in output.splitlines():
        fields = line.strip().split(None, 1)
        if len(fields) != 2 or fields[0] != str(process.pid):
            continue
        command = fields[1]
        if ("KERNEL_OBJ" in command or "KBUILD_SRC=" in command) and (
                "/make " in command or "KBUILD_SRC=" in command):
            return True
    return False


def build_command(build, jobs, target, resume=False):
    command = ["/bin/bash", str(build), "--make-mode", "--skip-soong-tests"]
    if resume:
        command += ["--skip-make", "--skip-soong"]
    return command + [f"-j{jobs}", target]


def process_table():
    output = subprocess.check_output(
        ["/bin/ps", "-axo", "pid=,ppid=,pgid=,stat=,lstart="], text=True
    )
    table = {}
    for line in output.splitlines():
        fields = line.split(None, 4)
        if len(fields) == 5:
            pid, parent, group = map(int, fields[:3])
            table[pid] = (parent, group, fields[3], fields[4])
    return table


def stop_build(process):
    # Ninja commands may use separate process groups. Keep their identities
    # before the driver exits so orphaned compilers cannot overlap a restart.
    tracked = {}

    def remaining():
        table = process_table()
        parents = {process.pid} if process.poll() is None else set()
        parents.update(pid for pid, started in tracked.items()
                       if pid in table and table[pid][3] == started)
        while True:
            children = {pid for pid, info in table.items() if info[0] in parents}
            if children <= parents:
                break
            parents.update(children)
        for pid in parents:
            if pid in table:
                tracked[pid] = table[pid][3]
        return {pid: table[pid] for pid, started in tracked.items()
                if pid in table and table[pid][3] == started
                and not table[pid][2].startswith("Z")}

    for sig, timeout in ((signal.SIGINT, 45), (signal.SIGTERM, 15),
                         (signal.SIGKILL, 5)):
        live = remaining()
        for pid in live:
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                pass
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if not remaining():
                process.wait()
                return
            time.sleep(0.2)
    raise RuntimeError("Build subprocesses did not stop; refusing to restart")


def monitor(process, jobs, max_jobs, high_limit, low_limit, low_for,
            progress_log, interval=5, samples=3, ready_file=None,
            ready_before=None):
    over_limit = 0
    low_since = None
    last_progress = log_mtime(progress_log)
    deferred = False
    while process.poll() is None:
        # Soong writes ninja.environment just before starting the main Ninja.
        # -j does not limit graph analysis, so restarting that phase cannot help.
        if ready_file is not None:
            ready = log_mtime(ready_file)
            if ready is None or ready == ready_before:
                time.sleep(interval)
                continue
            ready_file = None
            print("Build graph ready; monitoring compiler jobs.", flush=True)
        used = swap_used()
        headroom = free_memory()
        progress = log_mtime(progress_log)
        job_finished = progress is not None and progress != last_progress
        last_progress = progress
        change = None
        if jobs > 2:
            pressured = used >= high_limit or headroom < 4 * GIB
            over_limit = over_limit + 1 if pressured else 0
            if over_limit >= samples:
                change = "down"
        if jobs < max_jobs:
            if used < low_limit and headroom >= 6 * GIB:
                if low_since is None:
                    low_since = time.monotonic()
                # Only raise parallelism while Ninja is completing jobs.
                # Avoid interrupting graph generation or a lone long link.
                if time.monotonic() - low_since >= low_for and job_finished:
                    if change is None:
                        change = "up"
            else:
                low_since = None
        if change is not None:
            # Keep a running kernel recipe intact. Interrupted Image recipes
            # are not recorded as complete by Ninja and must run again.
            if kernel_running(process):
                if not deferred:
                    print("\nJob change pending; waiting for the kernel to finish.",
                          flush=True)
                deferred = True
            else:
                message = (f"Adjusting jobs {change}: swap {used / GIB:.2f} GiB, "
                           f"headroom {headroom / GIB:.2f} GiB.")
                if sys.stdout.isatty() and "NO_COLOR" not in os.environ:
                    message = f"\033[33m{message}\033[0m"
                print("\n" + message, flush=True)
                stop_build(process)
                return change
        time.sleep(interval)
    return process.returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path,
                        default=Path("/Volumes/AndroidBuild/lineage-21"))
    job_choices = tuple(range(2, 17, 2))
    parser.add_argument("--jobs", type=int, choices=job_choices, default=16)
    parser.add_argument("--max-jobs", type=int, choices=job_choices, default=16)
    parser.add_argument("--fallback-at", type=float, default=4,
                        help="Swap GiB at which to reduce jobs by two (default: 4)")
    parser.add_argument("--resume-below", type=float, default=2,
                        help="Swap GiB below which jobs may increase (default: 2)")
    parser.add_argument("--resume-after", type=float, default=300,
                        help="Seconds continuously below resume threshold (default: 300)")
    parser.add_argument("target", nargs="?", default="bacon")
    args = parser.parse_args()
    if not all(math.isfinite(value) for value in
               (args.resume_below, args.fallback_at, args.resume_after)):
        parser.error("Thresholds must be finite")
    if not 0 < args.resume_below < args.fallback_at or args.resume_after <= 0:
        parser.error("Require 0 < resume-below < fallback-at and resume-after > 0")
    if args.jobs > args.max_jobs:
        parser.error("jobs must not exceed max-jobs")
    root = args.root.resolve()
    build = root / "build/soong/soong_ui.bash"
    if not build.is_file():
        parser.error(f"Missing build script: {build}")
    config = root / "build/soong/ui/build/config.go"
    if not config.is_file() or 'arg == "--skip-soong"' not in config.read_text():
        parser.error("This launcher requires the androidbuild-darwin Soong --skip-soong patch")

    # Prevent two copies of this supervisor from running together.
    import fcntl
    lock = open(root / "out/.safe-build.lock", "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        parser.error("Another safe build is already running")

    jobs = args.jobs
    env = os.environ.copy()
    env.update(T=str(root), TARGET_PRODUCT="lineage_a5y17lte",
               TARGET_RELEASE="ap2a", TARGET_BUILD_VARIANT="userdebug",
               LINEAGE_BUILD="a5y17lte", GOMAXPROCS="2")
    env["PATH"] = ("/Volumes/AndroidBuild/tools/bin:"
                   f"{root}/prebuilts/build-tools/path/darwin-x86:"
                   + env.get("PATH", ""))

    process = None
    resume = False
    ready_file = root / "out/soong/ninja.environment"
    try:
        while True:
            print(f"Starting -j{jobs} (range 2..{args.max_jobs}); "
                  f"swap {swap_used() / GIB:.2f} GiB. "
                  "At -j2, swap never stops the build.", flush=True)
            ready_before = log_mtime(ready_file)
            process = subprocess.Popen(
                build_command(build, jobs, args.target, resume),
                cwd=root, env=env, start_new_session=True)
            result = monitor(
                process, jobs, args.max_jobs,
                high_limit=args.fallback_at * GIB,
                low_limit=args.resume_below * GIB,
                low_for=args.resume_after,
                progress_log=root / "out/.ninja_log",
                ready_file=None if resume else ready_file,
                ready_before=ready_before)
            if isinstance(result, int):
                return result if result >= 0 else 128 - result
            process = None
            resume = True
            jobs = min(args.max_jobs, jobs + 2) if result == "up" else max(2, jobs - 2)
            print(f"Resuming with -j{jobs} using the prepared graph. "
                  "Stop and relaunch after source or configuration edits.", flush=True)
    except KeyboardInterrupt:
        print("\nInterrupted; stopping build without restarting.", flush=True)
        if process is not None:
            stop_build(process)
        return 130
    except Exception:
        if process is not None:
            stop_build(process)
        raise
    finally:
        lock.close()


if __name__ == "__main__":
    sys.exit(main())
